<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    tools:context=".ui.SignUpActivity">

    <ImageView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/clay_circle_icon"
        android:padding="22dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo Aplikasi" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Buat Akun Baru"
        android:textColor="@color/clay_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Gabung dan mulai belanja dari petani lokal"
        android:textColor="@color/clay_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/clay_card_default"
        android:orientation="vertical"
        android:padding="22dp">

        <EditText
            android:id="@+id/signupEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/clay_input_field"
            android:paddingHorizontal="20dp"
            android:hint="Email"
            android:textSize="15sp"
            android:textColor="@color/clay_text_primary"
            android:textColorHint="@color/clay_text_tertiary"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/signupPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/clay_input_field"
            android:paddingHorizontal="20dp"
            android:hint="Password"
            android:textSize="15sp"
            android:textColor="@color/clay_text_primary"
            android:textColorHint="@color/clay_text_tertiary"
            android:inputType="textPassword" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:id="@+id/signupButton"
            android:background="@drawable/clay_button_primary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="0dp"
            android:text="Sign Up"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="Sudah memiliki akun? Log in"
        android:textColor="@color/clay_green_700"
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/loginText"/>

</LinearLayout>
