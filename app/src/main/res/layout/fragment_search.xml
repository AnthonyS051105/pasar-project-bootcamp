<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_background"
    android:orientation="vertical">

    <!-- Top Bar with Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/clay_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:paddingTop="28dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/clay_green_700" />

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:background="@drawable/clay_input_field"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Cari produk..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/clay_text_primary"
                android:textColorHint="@color/clay_text_tertiary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Filter Button -->
        <ImageView
            android:id="@+id/filterButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/clay_circle_icon"
            android:padding="11dp"
            android:src="@drawable/ic_filter"
            android:tint="@color/clay_green_700" />

    </LinearLayout>

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/clay_background"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recommendations Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rekomendasi"
                android:textColor="@color/clay_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommendationRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
