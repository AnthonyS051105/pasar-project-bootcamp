<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset "pressed-in" effect: light highlight bottom-right, dark shadow top-left -->
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_light" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface_alt" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
