<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow, offset bottom-right, larger blur illusion via double layer -->
    <item
        android:top="6dp"
        android:left="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_dark_soft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:top="4dp"
        android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_dark" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Light highlight, offset top-left -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_light" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Surface -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
