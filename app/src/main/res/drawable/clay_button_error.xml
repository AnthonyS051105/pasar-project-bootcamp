<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="5dp"
        android:left="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_dark" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_error" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
